PORT=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Seed only (go run ./cmd/seed). Min 12 characters; leave empty to skip creating the account.
# Never put real/production passwords here.
SEED_STAFF_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
# Set to true only when you intend to overwrite passwords of accounts that already exist.
SEED_RESET_PASSWORDS=

# Encrypts third-party access tokens (Meta Conversions API) stored in the database (AES-256-GCM).
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Changing it later makes stored tokens unreadable (travels must re-enter them).
APP_ENCRYPTION_KEY=

# Meta Marketing API version for Conversions API calls (default v25.0). Versions expire: check
# https://developers.facebook.com/docs/graph-api/changelog/versions and raise this when Meta releases a new one.
META_GRAPH_VERSION=

# Demo travel at demo.klikumroh.id (go run ./cmd/seed-demo --reset, nightly cron). Shared logins shown
# to visitors; fill on the server only. Passwords at least 8 characters.
DEMO_SLUG=demo
DEMO_ROOT_DOMAIN=klikumroh.id
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=

# Where the public site lives. The Syarat & Ketentuan / Kebijakan Privasi links filled into the platform settings
# when staff publish them are built from it (default https://klikumroh.id). Local dev: http://localhost:3000
PLATFORM_ORIGIN=
