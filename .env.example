PORT=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Seed only (go run ./cmd/seed). Min 12 characters; leave empty to skip creating the account.
# Never put real/production passwords here.
SEED_STAFF_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=
# Set to true only when you intend to overwrite passwords of accounts that already exist.
SEED_RESET_PASSWORDS=

# Encrypts third-party access tokens (Meta Conversions API) stored in the database (AES-256-GCM).
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Changing it later makes stored tokens unreadable (travels must re-enter them).
APP_ENCRYPTION_KEY=
